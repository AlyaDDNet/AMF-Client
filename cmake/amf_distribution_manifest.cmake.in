if(NOT DEFINED AMF_MANIFEST_ROOT)
	set(AMF_MANIFEST_ROOT "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@AMF_PORTABLE_DIRECTORY_NAME@")
endif()
set(AMF_MANIFEST_PATH "${AMF_MANIFEST_ROOT}/amf_distribution_manifest.txt")

file(GLOB_RECURSE AMF_MANIFEST_FILES LIST_DIRECTORIES false RELATIVE "${AMF_MANIFEST_ROOT}" "${AMF_MANIFEST_ROOT}/*")
list(REMOVE_ITEM AMF_MANIFEST_FILES "amf_distribution_manifest.txt")
list(SORT AMF_MANIFEST_FILES)

file(WRITE "${AMF_MANIFEST_PATH}" "# AMF Client distribution manifest v1\n")
foreach(AMF_MANIFEST_FILE IN LISTS AMF_MANIFEST_FILES)
	file(TO_CMAKE_PATH "${AMF_MANIFEST_FILE}" AMF_MANIFEST_FILE)
	file(APPEND "${AMF_MANIFEST_PATH}" "${AMF_MANIFEST_FILE}\n")
endforeach()
